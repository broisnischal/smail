{
  "name": "smail",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "shared"
  ],
  "scripts": {
    "start": "react-router-serve build/server/index.js",
    "build": "cd apps/ui && npm run build",
    "prisma:generate": "cd shared && npm prisma generate",
    "prisma:migrate": "cd shared && npm prisma migrate dev",
    "prisma:studio": "cd shared && npm prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "prisma": "^6.9.0"
  }
}