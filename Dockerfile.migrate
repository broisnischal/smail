# ───────────────────────────────────────────────────────────────────────────────
# Single-stage migration container
# ───────────────────────────────────────────────────────────────────────────────
FROM node:20-alpine

# Install OpenSSL for Prisma
RUN apk add --no-cache openssl

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./
COPY shared/package.json ./shared/

# Install dependencies
RUN npm ci

# Copy shared source files
COPY shared ./shared

# Generate Prisma client
WORKDIR /app/shared
RUN npx prisma generate --schema=./prisma/schema.prisma

# Create data directory
RUN mkdir -p /app/data

# Set working directory for migrations
WORKDIR /app/shared/prisma

# Simple command without script
CMD ["sh", "-c", "echo 'Starting migration...' && npx prisma migrate deploy && echo 'Migration completed'"]

